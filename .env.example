# -----------------------------------------------------------------------
# Super Admin bot configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` (with live tokens) to git or share it.
# -----------------------------------------------------------------------

# Telegram bot token for the Super Admin bot (from @BotFather)
SUPERADMIN_BOT_TOKEN=8764160656:AAFjlZpCgd2Gdott4cL9d70zfWxkRCtml7c

# Your personal Telegram numeric user ID (get it from @userinfobot)
SUPER_ADMIN_ID=REPLACE_WITH_YOUR_TELEGRAM_ID

# Credit Seller (Super Admin) payment account - where every host sends
# money when they top up credit via /addcredit
SELLER_TELEBIRR_ACCOUNT=0900000000
SELLER_TELEBIRR_HOLDER=YOUR NAME
SELLER_CBEBIRR_ACCOUNT=0900000000
SELLER_CBEBIRR_HOLDER=YOUR NAME

# Internal HTTP API the dynamically-launched host bots use to talk back
# to this Super Admin process. Keep these on localhost - Nginx should
# NOT proxy these publicly.
SUPERADMIN_API_HOST=127.0.0.1
SUPERADMIN_API_PORT=8091

# Shared secret used between the Super Admin process and each host's
# instance for the internal Host Control API and credit-request API.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
CREDIT_SELLER_API_SECRET=REPLACE_WITH_A_RANDOM_SECRET

# Optional: default display name given to newly created hosts and the
# demo starting credit balance (in Birr) they get.
HOST_NAME=Jemo Host
HOST_STARTING_CREDIT=1000
